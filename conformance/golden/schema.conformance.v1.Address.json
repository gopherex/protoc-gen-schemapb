      }
    },
    {
      "name": "zip",
      "string": {
        "pattern": "^[0-9]{5}$"
      }
    }
  ],
  "id": {
    "name": "Address",
    "namespace": "conformance.v1",
    "version": "v1.0.0"
  }
}
